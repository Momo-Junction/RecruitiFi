# Allowlist: secrets, databases, Git history and local artifacts never enter context.
**
!Dockerfile
!.dockerignore
!backend/
!backend/*.py
!backend/schema.sql
!backend/requirements.txt
backend/test_*.py
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
**/.env*
**/*.sqlite*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/__pycache__/**

!deploy/
!deploy/rahti/
!deploy/rahti/requirements.lock
